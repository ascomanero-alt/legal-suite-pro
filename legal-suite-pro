class DB:
    def __init__(self, name=DB_NAME):
        self.conn = sqlite3.connect(name)
        self.conn.row_factory = sqlite3.Row
        self.cur = self.conn.cursor()
        self.init()

    def init(self):
        self.cur.execute("CREATE TABLE IF NOT EXISTS clienti(id INTEGER PRIMARY KEY AUTOINCREMENT,nome TEXT NOT NULL,cognome TEXT NOT NULL,email TEXT,telefono TEXT,cf_piva TEXT,note TEXT,data_creazione TIMESTAMP DEFAULT CURRENT_TIMESTAMP)")
        self.cur.execute("CREATE TABLE IF NOT EXISTS pratiche(id INTEGER PRIMARY KEY AUTOINCREMENT,cliente_id INTEGER,numero_pratica TEXT UNIQUE,titolo TEXT NOT NULL,descrizione TEXT,tipo_pratica TEXT,stato TEXT DEFAULT 'Aperta',data_apertura TIMESTAMP DEFAULT CURRENT_TIMESTAMP,data_chiusura TIMESTAMP)")
        self.cur.execute("CREATE TABLE IF NOT EXISTS scadenze(id INTEGER PRIMARY KEY AUTOINCREMENT,pratica_id INTEGER,titolo TEXT NOT NULL,descrizione TEXT,data_scadenza DATE NOT NULL,priorita TEXT DEFAULT 'Media',stato TEXT DEFAULT 'In attesa',completato INTEGER DEFAULT 0,data_completamento TIMESTAMP)")
        self.cur.execute("CREATE TABLE IF NOT EXISTS udienze(id INTEGER PRIMARY KEY AUTOINCREMENT,pratica_id INTEGER,titolo TEXT NOT NULL,tribunale TEXT,giudice TEXT,aula TEXT,data_udienza DATE NOT NULL,ora_udienza TIME NOT NULL,tipo_udienza TEXT,esito TEXT,note TEXT)")
        self.cur.execute("CREATE TABLE IF NOT EXISTS agenda(id INTEGER PRIMARY KEY AUTOINCREMENT,cliente_id INTEGER,pratica_id INTEGER,titolo TEXT NOT NULL,descrizione TEXT,data_appuntamento DATE NOT NULL,ora_inizio TIME NOT NULL,ora_fine TIME,tipo_appuntamento TEXT,luogo TEXT,promemoria INTEGER DEFAULT 1)")
        self.conn.commit()

    def q(self, sql, args=()):
        self.cur.execute(sql, args)
        self.conn.commit()
        return self.cur.lastrowid

    def all(self, sql, args=()):
        self.cur.execute(sql, args)
        return [dict(r) for r in self.cur.fetchall()]

class CalcolatoreAndreani:
    festivi = {(1,1):"Capodanno",(1,6):"Epifania",(4,25):"Liberazione",(5,1):"Lavoro",(6,2):"Repubblica",(8,15):"Ferragosto",(11,1):"Ognissanti",(12,8):"Immacolata",(12,25):"Natale",(12,26):"Santo Stefano"}

    def pasqua(self, y):
        a=y%19; b=y//100; c=y%100; d=b//4; e=b%4; f=(b+8)//25; g=(b-f+1)//3
        h=(19*a+b-d-g+15)%30; i=c//4; k=c%4; l=(32+2*e+2*i-h-k)%7; m=(a+11*h+22*l)//451
        mo=(h+l-7*m+114)//31; da=((h+l-7*m+114)%31)+1
        return datetime(y, mo, da)

    def is_festivo(self, d):
        if d.weekday() == 6:
            return True
        if (d.month, d.day) in self.festivi:
            return True
        p = self.pasqua(d.year)
        return d.date() in {p.date(), (p + timedelta(days=1)).date()}

    def scadenza_giorni(self, start, giorni, ritroso=False, feriale=True):
        cur = start
        cnt = 0
        step = -1 if ritroso else 1
        while cnt < giorni:
            cur += timedelta(days=step)
            if feriale and cur.month == 8:
                continue
            if self.is_festivo(cur):
                continue
            cnt += 1
        while self.is_festivo(cur) or cur.weekday() == 5:
            cur += timedelta(days=1)
        return cur

class GoogleSync:
    def __init__(self):
        self.service = None
    def autentica(self):
        if not GOOGLE_OK or not CREDENTIALS_FILE.exists():
            return False
        creds = None
        if TOKEN_FILE.exists():
            with open(TOKEN_FILE, "rb") as f:
                creds = pickle.load(f)
        if not creds or not creds.valid:
            flow = InstalledAppFlow.from_client_secrets_file(str(CREDENTIALS_FILE), SCOPES)
            creds = flow.run_local_server(port=0)
            with open(TOKEN_FILE, "wb") as f:
                pickle.dump(creds, f)
        self.service = build("calendar", "v3", credentials=creds)
        return True
    def add_event(self, title, start, end, desc="", location="", all_day=False, color="9"):
        if not self.service:
            return None
        body = {"summary": title, "description": desc, "location": location, "colorId": color}
        if all_day:
            body["start"] = {"date": start.strftime("%Y-%m-%d"), "timeZone": "Europe/Rome"}
            body["end"] = {"date": (start + timedelta(days=1)).strftime("%Y-%m-%d"), "timeZone": "Europe/Rome"}
        else:
            body["start"] = {"dateTime": start.isoformat(), "timeZone": "Europe/Rome"}
            body["end"] = {"dateTime": end.isoformat(), "timeZone": "Europe/Rome"}
        ev = self.service.events().insert(calendarId="primary", body=body).execute()
        return ev.get("id")

class IconLineItem(OneLineIconListItem):
    icon = StringProperty("folder")
    def __init__(self, **kwargs):
        icon = kwargs.pop("icon", "folder")
        text = kwargs.pop("text", "")
        super().__init__(**kwargs)
        self.icon = icon
        self.text = text

class LegalSuiteApp(MDApp):
    status = StringProperty("Pronto")
    google_status = StringProperty("Google non connesso")

    def build(self):
        self.theme_cls.theme_style = "Light"
        self.theme_cls.primary_palette = "BlueGray"
        self.db = DB()
        self.calc = CalcolatoreAndreani()
        self.sync = GoogleSync()
        root = Builder.load_string(KV)
        self.carica_termini()
        return root

    def _set_list(self, list_widget, items):
        list_widget.clear_widgets()
        for text, icon in items:
            list_widget.add_widget(IconLineItem(text=text, icon=icon))

    def aggiungi_cliente(self, nome, cognome, email, telefono, cf_piva):
        if not nome or not cognome:
            self.status = "Nome e cognome obbligatori"
            return
        self.db.q("INSERT INTO clienti(nome,cognome,email,telefono,cf_piva) VALUES(?,?,?,?,?)", (nome, cognome, email, telefono, cf_piva))
        self.status = "Cliente aggiunto"
        self.carica_clienti()

    def carica_clienti(self):
        rows = self.db.all("SELECT * FROM clienti ORDER BY cognome, nome")
        self._set_list(self.root.get_screen("clienti").ids.lista_clienti, [(f"{r['cognome']} {r['nome']}", "account") for r in rows])

    def aggiungi_pratica(self, cliente_id, titolo, numero_pratica, tipo_pratica):
        if not cliente_id or not titolo or not numero_pratica:
            self.status = "Compila i campi principali"
            return
        self.db.q("INSERT INTO pratiche(cliente_id,numero_pratica,titolo,tipo_pratica) VALUES(?,?,?,?)", (int(cliente_id), titolo, numero_pratica, tipo_pratica))
        self.status = "Pratica aggiunta"
        self.carica_pratiche()

    def carica_pratiche(self):
        rows = self.db.all("SELECT p.*, c.nome, c.cognome FROM pratiche p JOIN clienti c ON p.cliente_id=c.id ORDER BY p.data_apertura DESC")
        self._set_list(self.root.get_screen("pratiche").ids.lista_pratiche, [(f"{r['numero_pratica']} - {r['titolo']} ({r['cognome']} {r['nome']})", "briefcase") for r in rows])

    def aggiungi_scadenza(self, pratica_id, titolo, data_scadenza, priorita):
        if not pratica_id or not titolo or not data_scadenza:
            self.status = "Compila i campi principali"
            return
        self.db.q("INSERT INTO scadenze(pratica_id,titolo,data_scadenza,priorita) VALUES(?,?,?,?)", (int(pratica_id), titolo, data_scadenza, priorita or "Media"))
        self.status = "Scadenza aggiunta"
        self.carica_scadenze()

    def carica_scadenze(self):
        rows = self.db.all("SELECT s.*, p.numero_pratica FROM scadenze s LEFT JOIN pratiche p ON s.pratica_id=p.id WHERE s.completato=0 ORDER BY s.data_scadenza")
        self._set_list(self.root.get_screen("scadenze").ids.lista_scadenze, [(f"{r['data_scadenza']} - {r['titolo']} ({r.get('numero_pratica') or ''})", "calendar-alert") for r in rows])

    def aggiungi_udienza(self, pratica_id, titolo, data_udienza, ora_udienza, tribunale):
        if not pratica_id or not titolo or not data_udienza or not ora_udienza:
            self.status = "Compila i campi principali"
            return
        self.db.q("INSERT INTO udienze(pratica_id,titolo,data_udienza,ora_udienza,tribunale) VALUES(?,?,?,?,?)", (int(pratica_id), titolo, data_udienza, ora_udienza, tribunale))
        self.status = "Udienza aggiunta"
        self.carica_udienze()

    def carica_udienze(self):
        rows = self.db.all("SELECT u.*, p.numero_pratica FROM udienze u LEFT JOIN pratiche p ON u.pratica_id=p.id ORDER BY u.data_udienza, u.ora_udienza")
        self._set_list(self.root.get_screen("udienze").ids.lista_udienze, [(f"{r['data_udienza']} {r['ora_udienza']} - {r['titolo']} ({r.get('numero_pratica') or ''})", "gavel") for r in rows])

    def aggiungi_appuntamento(self, titolo, data_appuntamento, ora_inizio, luogo):
        if not titolo or not data_appuntamento or not ora_inizio:
            self.status = "Compila i campi principali"
            return
        self.db.q("INSERT INTO agenda(titolo,data_appuntamento,ora_inizio,luogo) VALUES(?,?,?,?)", (titolo, data_appuntamento, ora_inizio, luogo))
        self.status = "Appuntamento aggiunto"
        self.carica_agenda()

    def carica_agenda(self):
        rows = self.db.all("SELECT * FROM agenda ORDER BY data_appuntamento, ora_inizio")
        self._set_list(self.root.get_screen("agenda").ids.lista_agenda, [(f"{r['data_appuntamento']} {r['ora_inizio']} - {r['titolo']}", "calendar") for r in rows])

    def calcola_termine(self, data_inizio, giorni):
        try:
            start = datetime.strptime(data_inizio, "%Y-%m-%d")
            sc = self.calc.scadenza_giorni(start, int(giorni))
            self.root.get_screen("termini").ids.risultato_termine.text = f"Scadenza: {sc.strftime('%Y-%m-%d')}"
            self.status = "Termine calcolato"
        except Exception:
            self.root.get_screen("termini").ids.risultato_termine.text = "Formato non valido"
            self.status = "Errore calcolo"

    def carica_termini(self):
        items = []
        for tipo, m in self.calc.termini.items():
            items.append((f"{tipo.upper()}", "timer"))
            for k, v in list(m.items())[:6]:
                items.append((f"{k} = {v} gg", "chevron-right"))
        self._set_list(self.root.get_screen("termini").ids.lista_termini, items)

    def google_autentica(self):
        self.google_status = "Google Calendar connesso" if self.sync.autentica() else "Google Calendar non disponibile"

    def sync_udienze_google(self):
        if not self.sync.autentica():
            self.google_status = "Autenticazione richiesta"
            return
        n = 0
        rows = self.db.all("SELECT u.*, p.numero_pratica FROM udienze u LEFT JOIN pratiche p ON u.pratica_id=p.id WHERE date(u.data_udienza) >= date('now')")
        for u in rows:
            d = datetime.strptime(u["data_udienza"], "%Y-%m-%d")
            t = datetime.strptime(u["ora_udienza"], "%H:%M")
            start = d.replace(hour=t.hour, minute=t.minute)
            end = start + timedelta(hours=1)
            if self.sync.add_event(f"UDIENZA: {u['titolo']}", start, end, f"Pratica: {u.get('numero_pratica','')}", u.get('tribunale',''), False, "2"):
                n += 1
        self.google_status = f"Sincronizzate {n} udienze"

    def sync_scadenze_google(self):
        if not self.sync.autentica():
            self.google_status = "Autenticazione richiesta"
            return
        n = 0
        rows = self.db.all("SELECT s.*, p.numero_pratica FROM scadenze s LEFT JOIN pratiche p ON s.pratica_id=p.id WHERE s.completato=0 AND date(s.data_scadenza) >= date('now')")
        for s in rows:
            d = datetime.strptime(s["data_scadenza"], "%Y-%m-%d")
            if self.sync.add_event(f"SCADENZA: {s['titolo']}", d, d + timedelta(days=1), f"Pratica: {s.get('numero_pratica','')}", all_day=True, color="11"):
                n += 1
        self.google_status = f"Sincronizzate {n} scadenze"

if __name__ == "__main__":
    LegalSuiteApp().run()
